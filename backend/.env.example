# NevoraX Backend - Environment Variables Example
# Copy this file to .env and fill in your values.

# --- CRITICAL SECRETS ---
# Get your API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Sepolia RPC URL (e.g., Infura, Alchemy, or your own node)
EVM_RPC=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_id_here

# WDK Seed Phrase (12 words)
# Ensure this account has Sepolia ETH and USDt
WDK_SEED_PHRASE="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"

# --- OPERATIONAL PARAMETERS (Optional) ---
# DEFAULT_BUDGET=50000000
# HOODI_RPC=https://ethereum-hoodi-rpc.publicnode.com
# GROQ_MODEL=llama-3.3-70b-versatile
